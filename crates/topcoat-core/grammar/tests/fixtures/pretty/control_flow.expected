fn classify(n: i64) -> &'static str {
    if n < 0 { "negative" } else if n == 0 { "zero" } else { "positive" }
}

fn drain(queue: &mut Vec<Task>) {
    'outer: while let Some(task) = queue.pop() {
        for step in task.steps() {
            match step {
                Step::Skip => continue,
                Step::Halt => break 'outer,
                Step::Run(action) if action.is_ready() => {
                    action.run();
                }
                Step::Run(_) => {
                    queue.push(task.clone());
                    break;
                }
            }
        }
    }
    loop {
        if queue.is_empty() {
            break
        }
        queue.remove(0);
    }
}
