fn main() {
{%- if tailwind %}
    // Scan the package for Tailwind classes and generate the stylesheet.
    topcoat::tailwind::BuildConfig::new()
        .input("styles.css")
        .render()
        .unwrap();
{%- endif %}
{%- if tailwind && !icon_sets.is_empty() %}
{% endif %}
{%- if !icon_sets.is_empty() %}
    // Download the Iconify sets used by `iconify_icon!` and stage them for compilation.
    topcoat::icon::iconify::BuildConfig::new()
{%- for set in icon_sets %}
        .icon_set("{{ set }}")
{%- endfor %}
        .stage()
        .unwrap();
{%- endif %}
}
