use topcoat::{
    Result,
    context::Cx,
    datastar::PatchElements,
    router::{{ "{" }}{{ paths.param() }}, route},
};

use super::patch_todo_list;
use crate::features::todo::Todo;

{{ paths.param() }}!(pub id: u64 else bad_request);

#[route{{ paths.route("PATCH", "/todos/{id}") }}]
pub async fn toggle(cx: &Cx) -> Result<PatchElements> {
    Todo::toggle(cx, *id(cx)?).await?;
    patch_todo_list(cx).await
}

#[route{{ paths.route("DELETE", "/todos/{id}") }}]
pub async fn delete(cx: &Cx) -> Result<PatchElements> {
    Todo::remove(cx, *id(cx)?).await?;
    patch_todo_list(cx).await
}
