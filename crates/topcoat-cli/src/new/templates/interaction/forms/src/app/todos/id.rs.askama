use topcoat::{
    Result,
    context::Cx,
    router::{
        error::{SeeOther, see_other},
        href, {{ paths.param() }}, route,
    },
};

use crate::features::todo::Todo;

{{ paths.param() }}!(pub id: u64 else bad_request);

#[route{{ paths.route_at("POST", "./toggle", "/todos/{id}/toggle") }}]
pub async fn toggle(cx: &Cx) -> Result<SeeOther> {
    Todo::toggle(cx, *id(cx)?).await?;
    Ok(see_other(href!(super::page).resolve(cx)))
}

#[route{{ paths.route_at("POST", "./delete", "/todos/{id}/delete") }}]
pub async fn delete(cx: &Cx) -> Result<SeeOther> {
    Todo::remove(cx, *id(cx)?).await?;
    Ok(see_other(href!(super::page).resolve(cx)))
}
