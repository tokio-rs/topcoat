<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><% if content_for?(:title) %><%= yield :title %> | <% end %>Harbor Market</title>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="data:,">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="flex min-h-screen flex-col bg-stone-50 text-stone-900 antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-white focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:shadow">Skip to content</a>
    <%= render "layouts/header" %>
    <main id="main" class="flex-1">
      <%= yield %>
    </main>
    <%= render "layouts/footer" %>
  </body>
</html>
