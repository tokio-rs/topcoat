<div class="bg-teal-900 px-4 py-2 text-center text-xs font-medium text-teal-50 sm:text-sm">
  Free shipping on orders over $75 and free 30-day returns
</div>
<header class="sticky top-0 z-20 border-b border-stone-200 bg-white/95 backdrop-blur">
  <div data-controller="menu" class="mx-auto flex max-w-7xl flex-wrap items-center gap-x-10 gap-y-3 px-4 py-3 sm:px-6 lg:px-8">
    <%= link_to root_path, class: "flex items-center gap-2.5 text-lg font-semibold tracking-tight text-stone-900" do %>
      <%= render "shared/logo" %>
      Harbor Market
    <% end %>
    <nav id="site-nav" aria-label="Main" data-menu-target="nav" class="order-last hidden w-full md:order-none md:block md:w-auto">
      <ul class="flex flex-col gap-1 border-t border-stone-100 pt-3 md:flex-row md:gap-8 md:border-0 md:pt-0">
        <% [
          [ "All products", products_path ],
          [ "Outdoor", products_path(category: "outdoor") ],
          [ "Kitchen", products_path(category: "kitchen") ],
          [ "Electronics", products_path(category: "electronics") ],
          [ "About", about_path ]
        ].each do |label, path| %>
          <li>
            <%= link_to label, path, class: "block rounded-md px-2 py-2 text-sm font-medium text-stone-600 hover:bg-stone-100 hover:text-stone-900 md:p-0 md:hover:bg-transparent" %>
          </li>
        <% end %>
      </ul>
    </nav>
    <div class="ml-auto flex items-center gap-2">
      <div class="flex items-center gap-2 rounded-full border border-stone-200 bg-white py-1.5 pl-3 pr-1.5 text-sm font-medium text-stone-700">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="size-5"><path d="M6 8h12l-1 12H7L6 8ZM9 8a3 3 0 0 1 6 0"></path></svg>
        <span class="hidden sm:inline">Cart</span>
        <span data-controller="cart-badge" data-action="product-form:added@window->cart-badge#update" class="min-w-6 rounded-full bg-teal-700 px-2 py-0.5 text-center text-xs font-semibold text-white"><%= cart_badge(cart_count) %></span>
      </div>
      <button type="button" data-menu-target="button" data-action="menu#toggle" aria-controls="site-nav" aria-expanded="false" class="rounded-md p-2 text-stone-600 hover:bg-stone-100 md:hidden">
        <span class="sr-only">Toggle menu</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="size-6"><path d="M4 6h16M4 12h16M4 18h16"></path></svg>
      </button>
    </div>
  </div>
</header>
