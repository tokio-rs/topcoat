<%# locals: (code:) -%>
<% title, message = if code == 404
  [ "Page not found", "Sorry, we couldn't find the page you're looking for." ]
else
  [ "Invalid request", "Some of the filters in this link aren't valid. Try browsing from the catalog instead." ]
end %>
<% content_for :title, title %>
<div class="mx-auto max-w-2xl px-4 py-24 text-center sm:py-32">
  <p class="text-sm font-semibold text-teal-700"><%= code %></p>
  <h1 class="mt-3 text-4xl font-semibold tracking-tight text-stone-900"><%= title %></h1>
  <p class="mt-4 text-stone-600"><%= message %></p>
  <div class="mt-10 flex flex-wrap justify-center gap-4">
    <%= link_to "Back to home", root_path, class: "rounded-full bg-teal-700 px-6 py-3 text-sm font-semibold text-white hover:bg-teal-800" %>
    <%= link_to "Browse products", products_path, class: "rounded-full px-6 py-3 text-sm font-semibold text-stone-700 ring-1 ring-inset ring-stone-300 hover:bg-stone-100" %>
  </div>
</div>
