<%# locals: (filled:, label:, size:) -%>
<span class="flex items-center gap-0.5" role="img" aria-label="Rated <%= label %> out of 5">
  <% 5.times do |star| %>
    <svg viewBox="0 0 20 20" class="<%= ProductsHelper::STAR_CLASSES.dig(size, star < filled) %>"><path d="M10 1l3 6 6 1-4 4 1 6-6-3-6 3 1-6-4-4 6-1z"></path></svg>
  <% end %>
</span>
