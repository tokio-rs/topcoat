<%# locals: (review:) -%>
<li class="py-6 first:pt-0">
  <article>
    <div class="flex items-center justify-between gap-4">
      <%= render "shared/stars", filled: review.rating, label: review.rating, size: :small %>
      <time datetime="<%= review.date.iso8601 %>" class="text-sm text-stone-500"><%= review.date.to_fs(:storefront) %></time>
    </div>
    <h3 class="mt-3 font-semibold text-stone-900"><%= review.title %></h3>
    <p class="mt-2 leading-7 text-stone-600"><%= review.body %></p>
    <p class="mt-3 text-sm font-medium text-stone-900"><%= review.author %></p>
  </article>
</li>
