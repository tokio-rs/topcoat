<%# locals: (product:) -%>
<% stepper_button = "rounded-full p-2.5 text-stone-700 hover:bg-stone-100 disabled:cursor-not-allowed disabled:opacity-30 disabled:hover:bg-transparent" %>
<% if product.sold_out? %>
  <div class="mt-8">
    <button type="button" disabled class="w-full cursor-not-allowed rounded-full bg-stone-200 px-8 py-3.5 text-base font-semibold text-stone-500">Sold out</button>
  </div>
<% else %>
  <div data-controller="product-form" data-product-form-max-value="<%= product.max_quantity %>" class="mt-8">
    <div class="flex flex-col gap-3 sm:flex-row">
      <div class="flex items-center justify-between rounded-full border border-stone-300 bg-white p-1 sm:w-36">
        <button type="button" data-product-form-target="decrement" data-action="product-form#decrement" aria-label="Decrease quantity" disabled class="<%= stepper_button %>"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="size-4"><path d="M5 12h14"></path></svg></button>
        <output data-product-form-target="quantity" aria-live="polite" aria-label="Quantity" class="w-10 text-center font-semibold tabular-nums">1</output>
        <button type="button" data-product-form-target="increment" data-action="product-form#increment" aria-label="Increase quantity" <%= "disabled" if product.max_quantity <= 1 %> class="<%= stepper_button %>"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="size-4"><path d="M12 5v14M5 12h14"></path></svg></button>
      </div>
      <button type="button" data-action="product-form#add" class="flex-1 rounded-full bg-teal-700 px-8 py-3.5 text-base font-semibold text-white shadow-sm hover:bg-teal-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700">Add to cart</button>
    </div>
    <p data-product-form-target="status" role="status" class="mt-3 min-h-5 text-sm font-medium text-teal-800"></p>
  </div>
<% end %>
