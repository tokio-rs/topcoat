<%
  product = @product
  category = product.category
  category_path = listing_path(category:)
  rating = format_rating(product.rating)
  filled = filled_stars(product.rating_tenths)
  content_for :title, product.name
%>
<div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
  <%= render "shared/breadcrumbs", trail: [ [ "Home", root_path ], [ "Products", products_path ], [ category.name, category_path ] ], current: product.name %>
  <div class="mt-8 grid gap-10 lg:grid-cols-2 lg:gap-16">
    <div class="lg:sticky lg:top-24 lg:self-start">
      <%= render "products/image", product: %>
    </div>
    <div>
      <%= link_to category.name, category_path, class: "text-sm font-semibold text-teal-700 hover:text-teal-900" %>
      <h1 class="mt-2 text-3xl font-semibold tracking-tight text-balance text-stone-900 sm:text-4xl"><%= product.name %></h1>
      <div class="mt-3 flex items-center gap-2">
        <%= render "shared/stars", filled:, label: rating, size: :large %>
        <span class="text-sm font-medium text-stone-900"><%= rating %></span>
        <a href="#reviews" class="text-sm text-stone-500 underline-offset-4 hover:text-stone-900 hover:underline"><%= number_with_delimiter(product.review_count) %> reviews</a>
      </div>
      <div class="mt-6 flex flex-wrap items-baseline gap-3">
        <p class="text-3xl font-semibold tracking-tight text-stone-900"><%= money(product.price_cents) %></p>
        <% if product.on_sale? %>
          <% saving = product.compare_at_cents - product.price_cents %>
          <s class="text-lg text-stone-400"><%= money(product.compare_at_cents) %></s>
          <span class="rounded-full bg-rose-50 px-2.5 py-1 text-sm font-medium text-rose-700">Save <%= money(saving) %> (<%= saving * 100 / product.compare_at_cents %>%)</span>
        <% end %>
      </div>
      <p class="mt-4 text-lg leading-8 text-stone-600"><%= product.tagline %></p>
      <dl class="mt-6 grid grid-cols-[auto_1fr] gap-x-8 gap-y-3 text-sm">
        <dt class="font-medium text-stone-900">Color</dt>
        <dd class="flex items-center gap-2 text-stone-600">
          <span class="size-4 rounded-full ring-1 ring-black/10 <%= swatch(product).accent %>"></span>
          <%= swatch(product).label %>
        </dd>
        <dt class="font-medium text-stone-900">Availability</dt>
        <% if product.sold_out? %>
          <dd class="font-medium text-stone-500">Sold out</dd>
        <% elsif product.stock < 10 %>
          <dd class="font-medium text-amber-700">Only <%= product.stock %> left in stock</dd>
        <% else %>
          <dd class="font-medium text-emerald-700">In stock</dd>
        <% end %>
      </dl>
      <%= render "products/purchase", product: %>
      <ul class="mt-8 space-y-3 border-t border-stone-200 pt-6 text-sm text-stone-600">
        <li class="flex items-center gap-3"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="size-5 text-teal-700"><path d="m5 12 5 5L20 7"></path></svg>Free shipping on orders over $75</li>
        <li class="flex items-center gap-3"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="size-5 text-teal-700"><path d="m5 12 5 5L20 7"></path></svg>Free 30-day returns</li>
        <li class="flex items-center gap-3"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="size-5 text-teal-700"><path d="m5 12 5 5L20 7"></path></svg>Ships within one business day</li>
      </ul>
    </div>
  </div>
  <div class="mt-16 grid gap-12 border-t border-stone-200 pt-16 lg:grid-cols-2">
    <section>
      <h2 class="text-xl font-semibold tracking-tight">Description</h2>
      <div class="mt-4 space-y-4 leading-7 text-stone-600">
        <% product.paragraphs.each do |paragraph| %>
          <p><%= paragraph %></p>
        <% end %>
      </div>
    </section>
    <section>
      <h2 class="text-xl font-semibold tracking-tight">Specifications</h2>
      <table class="mt-4 w-full text-left text-sm">
        <tbody class="divide-y divide-stone-200 border-y border-stone-200">
          <% product.specs.each do |spec| %>
            <tr>
              <th scope="row" class="w-2/5 py-3 pr-4 font-medium text-stone-900"><%= spec.label %></th>
              <td class="py-3 text-stone-600"><%= spec.value %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </section>
  </div>
  <section id="reviews" class="mt-16 grid gap-10 border-t border-stone-200 pt-16 lg:grid-cols-[18rem_1fr]">
    <div>
      <h2 class="text-xl font-semibold tracking-tight">Customer reviews</h2>
      <div class="mt-4 flex items-center gap-3">
        <p class="text-4xl font-semibold tracking-tight"><%= rating %></p>
        <%= render "shared/stars", filled:, label: rating, size: :large %>
      </div>
      <p class="mt-2 text-sm text-stone-600">Based on <%= number_with_delimiter(product.review_count) %> reviews</p>
      <p class="mt-1 text-sm text-stone-500">Showing the <%= product.reviews.size %> most recent.</p>
    </div>
    <ul class="divide-y divide-stone-200">
      <%= render partial: "products/review", collection: product.reviews %>
    </ul>
  </section>
  <section aria-labelledby="related-heading" class="mt-16 border-t border-stone-200 pt-16">
    <h2 id="related-heading" class="text-xl font-semibold tracking-tight">You might also like</h2>
    <div class="mt-8 grid grid-cols-2 gap-x-6 gap-y-10 lg:grid-cols-4">
      <%= render partial: "products/card", collection: catalog.related(product), as: :product %>
    </div>
  </section>
</div>
