<%# locals: (product:) -%>
<% rating = format_rating(product.rating) %>
<article class="group relative flex flex-col">
  <%= render "products/image", product: %>
  <div class="mt-4 flex flex-1 flex-col">
    <p class="text-xs font-medium uppercase tracking-wide text-stone-500"><%= product.category.name %></p>
    <h3 class="mt-1 text-sm font-semibold text-stone-900 group-hover:text-teal-800">
      <%= link_to product_path(product) do %>
        <span class="absolute inset-0"></span>
        <%= product.name %>
      <% end %>
    </h3>
    <p class="mt-1 line-clamp-2 text-sm text-stone-600"><%= product.tagline %></p>
    <div class="mt-2 flex items-center gap-1.5">
      <%= render "shared/stars", filled: filled_stars(product.rating_tenths), label: rating, size: :small %>
      <span class="text-xs text-stone-500"><%= rating %> (<%= number_with_delimiter(product.review_count) %>)</span>
    </div>
    <div class="mt-auto flex items-end justify-between gap-2 pt-3">
      <p class="flex items-baseline gap-2">
        <span class="font-semibold text-stone-900"><%= money(product.price_cents) %></span>
        <% if product.on_sale? %>
          <s class="text-sm text-stone-400"><%= money(product.compare_at_cents) %></s>
        <% end %>
      </p>
      <span class="flex items-center gap-1.5 text-xs text-stone-500">
        <span class="size-3 rounded-full ring-1 ring-black/10 <%= swatch(product).accent %>"></span>
        <%= swatch(product).label %>
      </span>
    </div>
    <% if product.stock.between?(1, 9) %>
      <p class="mt-1 text-xs font-medium text-amber-700">Only <%= product.stock %> left</p>
    <% end %>
  </div>
</article>
