#!/bin/sh

# The benchmark runs a single node without a remote console, so distribution (and the epmd
# daemon it would start outside the server's process group) stays off.
export RELEASE_DISTRIBUTION=none

# BENCH_THREADS=N runs the VM with N schedulers online (and N dirty CPU schedulers, so NIF work
# cannot spill onto more cores). Unset or 0 keeps the BEAM default of one scheduler per core.
case "${BENCH_THREADS:-0}" in
  0) ;;
  *[!0-9]*)
    echo "invalid BENCH_THREADS \"$BENCH_THREADS\"" >&2
    exit 1
    ;;
  *)
    export ELIXIR_ERL_OPTIONS="+S $BENCH_THREADS:$BENCH_THREADS +SDcpu $BENCH_THREADS:$BENCH_THREADS ${ELIXIR_ERL_OPTIONS:-}"
    ;;
esac
