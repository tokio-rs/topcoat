<Layouts.app cart_count={@cart_count}>
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <.breadcrumbs
      trail={[
        {"Home", ~p"/"},
        {"Products", ~p"/products"},
        {@category.name, listing_path(@category.slug)}
      ]}
      current={@product.name}
    />
    <div class="mt-8 grid gap-10 lg:grid-cols-2 lg:gap-16">
      <div class="lg:sticky lg:top-24 lg:self-start">
        <.product_image product={@product} />
      </div>
      <div>
        <a
          href={listing_path(@category.slug)}
          class="text-sm font-semibold text-teal-700 hover:text-teal-900"
        >
          {@category.name}
        </a>
        <h1 class="mt-2 text-3xl font-semibold tracking-tight text-balance text-stone-900 sm:text-4xl">
          {@product.name}
        </h1>
        <div class="mt-3 flex items-center gap-2">
          <.stars
            filled={filled_stars(Product.rating_tenths(@product))}
            rating={rating(@product.rating)}
            size={:large}
          />
          <span class="text-sm font-medium text-stone-900">{rating(@product.rating)}</span>
          <a
            href="#reviews"
            class="text-sm text-stone-500 underline-offset-4 hover:text-stone-900 hover:underline"
          >
            {count(@product.review_count)} reviews
          </a>
        </div>
        <div class="mt-6 flex flex-wrap items-baseline gap-3">
          <p class="text-3xl font-semibold tracking-tight text-stone-900">
            {money(@product.price_cents)}
          </p>
          <%= if @product.compare_at_cents do %>
            <s class="text-lg text-stone-400">{money(@product.compare_at_cents)}</s>
            <span class="rounded-full bg-rose-50 px-2.5 py-1 text-sm font-medium text-rose-700">
              Save {money(savings_cents(@product))} ({savings_percent(@product)}%)
            </span>
          <% end %>
        </div>
        <p class="mt-4 text-lg leading-8 text-stone-600">{@product.tagline}</p>
        <dl class="mt-6 grid grid-cols-[auto_1fr] gap-x-8 gap-y-3 text-sm">
          <dt class="font-medium text-stone-900">Color</dt>
          <dd class="flex items-center gap-2 text-stone-600">
            <span class={"size-4 rounded-full ring-1 ring-black/10 " <> color_accent(@product.color)}></span>
            {color_label(@product.color)}
          </dd>
          <dt class="font-medium text-stone-900">Availability</dt>
          <.availability stock={@product.stock} />
        </dl>
        <%= if @product.stock == 0 do %>
          <div class="mt-8">
            <button
              type="button"
              disabled
              class="w-full cursor-not-allowed rounded-full bg-stone-200 px-8 py-3.5 text-base font-semibold text-stone-500"
            >
              Sold out
            </button>
          </div>
        <% else %>
          <div data-product-form data-max={Product.max_quantity(@product)} class="mt-8">
            <div class="flex flex-col gap-3 sm:flex-row">
              <div class="flex items-center justify-between rounded-full border border-stone-300 bg-white p-1 sm:w-36">
                <button
                  type="button"
                  data-step="-1"
                  aria-label="Decrease quantity"
                  disabled
                  class={stepper_button_class()}
                >
                  <Icons.minus />
                </button>
                <output
                  data-quantity
                  aria-live="polite"
                  aria-label="Quantity"
                  class="w-10 text-center font-semibold tabular-nums"
                >1</output>
                <button
                  type="button"
                  data-step="1"
                  aria-label="Increase quantity"
                  disabled={Product.max_quantity(@product) <= 1}
                  class={stepper_button_class()}
                >
                  <Icons.plus />
                </button>
              </div>
              <button
                type="button"
                data-add-to-cart
                class="flex-1 rounded-full bg-teal-700 px-8 py-3.5 text-base font-semibold text-white shadow-sm hover:bg-teal-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700"
              >
                Add to cart
              </button>
            </div>
            <p
              data-cart-status
              role="status"
              class="mt-3 min-h-5 text-sm font-medium text-teal-800"
            >
            </p>
          </div>
        <% end %>
        <ul class="mt-8 space-y-3 border-t border-stone-200 pt-6 text-sm text-stone-600">
          <li class="flex items-center gap-3"><Icons.check />Free shipping on orders over $75</li>
          <li class="flex items-center gap-3"><Icons.check />Free 30-day returns</li>
          <li class="flex items-center gap-3"><Icons.check />Ships within one business day</li>
        </ul>
      </div>
    </div>
    <div class="mt-16 grid gap-12 border-t border-stone-200 pt-16 lg:grid-cols-2">
      <section>
        <h2 class="text-xl font-semibold tracking-tight">Description</h2>
        <div class="mt-4 space-y-4 leading-7 text-stone-600">
          <p :for={paragraph <- Product.paragraphs(@product)}>{paragraph}</p>
        </div>
      </section>
      <section>
        <h2 class="text-xl font-semibold tracking-tight">Specifications</h2>
        <table class="mt-4 w-full text-left text-sm">
          <tbody class="divide-y divide-stone-200 border-y border-stone-200">
            <tr :for={spec <- @product.specs}>
              <th scope="row" class="w-2/5 py-3 pr-4 font-medium text-stone-900">{spec.label}</th>
              <td class="py-3 text-stone-600">{spec.value}</td>
            </tr>
          </tbody>
        </table>
      </section>
    </div>
    <section
      id="reviews"
      class="mt-16 grid gap-10 border-t border-stone-200 pt-16 lg:grid-cols-[18rem_1fr]"
    >
      <div>
        <h2 class="text-xl font-semibold tracking-tight">Customer reviews</h2>
        <div class="mt-4 flex items-center gap-3">
          <p class="text-4xl font-semibold tracking-tight">{rating(@product.rating)}</p>
          <.stars
            filled={filled_stars(Product.rating_tenths(@product))}
            rating={rating(@product.rating)}
            size={:large}
          />
        </div>
        <p class="mt-2 text-sm text-stone-600">
          Based on {count(@product.review_count)} reviews
        </p>
        <p class="mt-1 text-sm text-stone-500">
          Showing the {length(@product.reviews)} most recent.
        </p>
      </div>
      <ul class="divide-y divide-stone-200">
        <li :for={review <- @product.reviews} class="py-6 first:pt-0">
          <article>
            <div class="flex items-center justify-between gap-4">
              <.stars filled={review.rating} rating={review.rating} size={:small} />
              <time datetime={iso_date(review.date)} class="text-sm text-stone-500">
                {short_date(review.date)}
              </time>
            </div>
            <h3 class="mt-3 font-semibold text-stone-900">{review.title}</h3>
            <p class="mt-2 leading-7 text-stone-600">{review.body}</p>
            <p class="mt-3 text-sm font-medium text-stone-900">{review.author}</p>
          </article>
        </li>
      </ul>
    </section>
    <section aria-labelledby="related-heading" class="mt-16 border-t border-stone-200 pt-16">
      <h2 id="related-heading" class="text-xl font-semibold tracking-tight">
        You might also like
      </h2>
      <div class="mt-8 grid grid-cols-2 gap-x-6 gap-y-10 lg:grid-cols-4">
        <.product_card :for={related <- @related} product={related} />
      </div>
    </section>
  </div>
</Layouts.app>
