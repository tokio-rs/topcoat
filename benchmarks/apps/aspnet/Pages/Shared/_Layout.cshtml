<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@(ViewData["Title"] is string title ? $"{title} | Harbor Market" : "Harbor Market")</title>
    <link rel="icon" href="data:,">
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true">
    <script src="~/js/app.js" asp-append-version="true" defer></script>
</head>
<body class="flex min-h-screen flex-col bg-stone-50 text-stone-900 antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-white focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:shadow">Skip to content</a>
    <partial name="_Header" />
    <main id="main" class="flex-1">
        @RenderBody()
    </main>
    <partial name="_Footer" />
</body>
</html>
