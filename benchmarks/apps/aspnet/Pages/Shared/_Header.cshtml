@functions {
    private const string NavLink = "block rounded-md px-2 py-2 text-sm font-medium text-stone-600 hover:bg-stone-100 hover:text-stone-900 md:p-0 md:hover:bg-transparent";
}
<div class="bg-teal-900 px-4 py-2 text-center text-xs font-medium text-teal-50 sm:text-sm">
    Free shipping on orders over $75 and free 30-day returns
</div>
<header class="sticky top-0 z-20 border-b border-stone-200 bg-white/95 backdrop-blur">
    <div class="mx-auto flex max-w-7xl flex-wrap items-center gap-x-10 gap-y-3 px-4 py-3 sm:px-6 lg:px-8">
        <a asp-page="/Index" class="flex items-center gap-2.5 text-lg font-semibold tracking-tight text-stone-900">
            @Icons.Logo
            Harbor Market
        </a>
        <nav id="site-nav" aria-label="Main" class="order-last hidden w-full md:order-none md:block md:w-auto">
            <ul class="flex flex-col gap-1 border-t border-stone-100 pt-3 md:flex-row md:gap-8 md:border-0 md:pt-0">
                <li><a asp-page="/Products/Index" class="@NavLink">All products</a></li>
                <li><a asp-page="/Products/Index" asp-route-category="outdoor" class="@NavLink">Outdoor</a></li>
                <li><a asp-page="/Products/Index" asp-route-category="kitchen" class="@NavLink">Kitchen</a></li>
                <li><a asp-page="/Products/Index" asp-route-category="electronics" class="@NavLink">Electronics</a></li>
                <li><a asp-page="/About" class="@NavLink">About</a></li>
            </ul>
        </nav>
        <div class="ml-auto flex items-center gap-2">
            <div class="flex items-center gap-2 rounded-full border border-stone-200 bg-white py-1.5 pl-3 pr-1.5 text-sm font-medium text-stone-700">
                @Icons.Bag
                <span class="hidden sm:inline">Cart</span>
                <span data-cart-count class="min-w-6 rounded-full bg-teal-700 px-2 py-0.5 text-center text-xs font-semibold text-white">@Cart.BadgeText(Cart.Count(Context.Request))</span>
            </div>
            <button type="button" data-menu-toggle aria-controls="site-nav" aria-expanded="false" class="rounded-md p-2 text-stone-600 hover:bg-stone-100 md:hidden">
                <span class="sr-only">Toggle menu</span>
                @Icons.Menu
            </button>
        </div>
    </div>
</header>
