<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Harbor</RootNamespace>
    <!-- Pin the restore graph; the app has no package references, so this only records the framework. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- The Web SDK already defaults to Server GC with concurrent collections and tiered PGO. Spelled
         out so the production settings are visible in one place. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <!-- `tailwindcss` from PATH, or the binary named by the TAILWINDCSS environment variable. -->
    <TailwindCss Condition="'$(TAILWINDCSS)' != ''">$(TAILWINDCSS)</TailwindCss>
    <TailwindCss Condition="'$(TailwindCss)' == ''">tailwindcss</TailwindCss>
    <TailwindOutput>wwwroot/css/app.css</TailwindOutput>
  </PropertyGroup>

  <ItemGroup>
    <!-- Generated by the Tailwind target below and added back as content once it exists. -->
    <Content Remove="$(TailwindOutput)" />
  </ItemGroup>

  <!-- Compiles the Tailwind stylesheet before static web assets are collected, so it is fingerprinted
       and precompressed like any other file in wwwroot. -->
  <Target Name="Tailwind" BeforeTargets="ResolveStaticWebAssetsConfiguration;ResolveProjectStaticWebAssets;AssignTargetPaths">
    <Exec Command="&quot;$(TailwindCss)&quot; --input Styles/app.css --output $(TailwindOutput) --minify" />
    <ItemGroup>
      <Content Include="$(TailwindOutput)" />
    </ItemGroup>
  </Target>

</Project>
