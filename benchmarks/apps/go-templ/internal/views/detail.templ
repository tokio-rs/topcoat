package views

import (
	"strconv"

	"harbor-go-templ/internal/catalog"
	"harbor-go-templ/internal/format"
)

const stepperButton = "rounded-full p-2.5 text-stone-700 hover:bg-stone-100 disabled:cursor-not-allowed disabled:opacity-30 disabled:hover:bg-transparent"

// DetailPage is GET /products/{id}: product details, specifications, reviews and related
// products.
templ DetailPage(p *catalog.Product, cart int) {
	{{ categoryHref := categoryURL(p.Category.Slug) }}
	{{ rating := format.Rating(p.Rating) }}
	@layout(p.Name, cart) {
		<div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
			@breadcrumbs([]link{{"/", "Home"}, {"/products", "Products"}, {categoryHref, p.Category.Name}}, p.Name)
			<div class="mt-8 grid gap-10 lg:grid-cols-2 lg:gap-16">
				<div class="lg:sticky lg:top-24 lg:self-start">
					@productImage(p)
				</div>
				<div>
					<a href={ categoryHref } class="text-sm font-semibold text-teal-700 hover:text-teal-900">{ p.Category.Name }</a>
					<h1 class="mt-2 text-3xl font-semibold tracking-tight text-balance text-stone-900 sm:text-4xl">{ p.Name }</h1>
					<div class="mt-3 flex items-center gap-2">
						@stars(filledStars(p.RatingTenths()), rating, largeStars)
						<span class="text-sm font-medium text-stone-900">{ rating }</span>
						<a href="#reviews" class="text-sm text-stone-500 underline-offset-4 hover:text-stone-900 hover:underline">
							{ format.Count(p.ReviewCount) } reviews
						</a>
					</div>
					<div class="mt-6 flex flex-wrap items-baseline gap-3">
						<p class="text-3xl font-semibold tracking-tight text-stone-900">{ format.Money(p.PriceCents) }</p>
						if p.CompareAtCents != nil {
							{{ compareAt := *p.CompareAtCents }}
							<s class="text-lg text-stone-400">{ format.Money(compareAt) }</s>
							<span class="rounded-full bg-rose-50 px-2.5 py-1 text-sm font-medium text-rose-700">
								Save { format.Money(compareAt - p.PriceCents) } ({ (compareAt - p.PriceCents) * 100 / compareAt }%)
							</span>
						}
					</div>
					<p class="mt-4 text-lg leading-8 text-stone-600">{ p.Tagline }</p>
					<dl class="mt-6 grid grid-cols-[auto_1fr] gap-x-8 gap-y-3 text-sm">
						<dt class="font-medium text-stone-900">Color</dt>
						<dd class="flex items-center gap-2 text-stone-600">
							<span class={ "size-4 rounded-full ring-1 ring-black/10 " + accent(p.Color) }></span>
							{ p.Color.Label() }
						</dd>
						<dt class="font-medium text-stone-900">Availability</dt>
						if p.Stock == 0 {
							<dd class="font-medium text-stone-500">Sold out</dd>
						} else if p.Stock < 10 {
							<dd class="font-medium text-amber-700">Only { p.Stock } left in stock</dd>
						} else {
							<dd class="font-medium text-emerald-700">In stock</dd>
						}
					</dl>
					@purchase(p)
					<ul class="mt-8 space-y-3 border-t border-stone-200 pt-6 text-sm text-stone-600">
						<li class="flex items-center gap-3">
							@iconCheck()
							Free shipping on orders over $75
						</li>
						<li class="flex items-center gap-3">
							@iconCheck()
							Free 30-day returns
						</li>
						<li class="flex items-center gap-3">
							@iconCheck()
							Ships within one business day
						</li>
					</ul>
				</div>
			</div>
			<div class="mt-16 grid gap-12 border-t border-stone-200 pt-16 lg:grid-cols-2">
				<section>
					<h2 class="text-xl font-semibold tracking-tight">Description</h2>
					<div class="mt-4 space-y-4 leading-7 text-stone-600">
						for _, paragraph := range p.Paragraphs() {
							<p>{ paragraph }</p>
						}
					</div>
				</section>
				<section>
					<h2 class="text-xl font-semibold tracking-tight">Specifications</h2>
					<table class="mt-4 w-full text-left text-sm">
						<tbody class="divide-y divide-stone-200 border-y border-stone-200">
							for _, spec := range p.Specs {
								<tr>
									<th scope="row" class="w-2/5 py-3 pr-4 font-medium text-stone-900">{ spec.Label }</th>
									<td class="py-3 text-stone-600">{ spec.Value }</td>
								</tr>
							}
						</tbody>
					</table>
				</section>
			</div>
			<section id="reviews" class="mt-16 grid gap-10 border-t border-stone-200 pt-16 lg:grid-cols-[18rem_1fr]">
				<div>
					<h2 class="text-xl font-semibold tracking-tight">Customer reviews</h2>
					<div class="mt-4 flex items-center gap-3">
						<p class="text-4xl font-semibold tracking-tight">{ rating }</p>
						@stars(filledStars(p.RatingTenths()), rating, largeStars)
					</div>
					<p class="mt-2 text-sm text-stone-600">Based on { format.Count(p.ReviewCount) } reviews</p>
					<p class="mt-1 text-sm text-stone-500">Showing the { len(p.Reviews) } most recent.</p>
				</div>
				<ul class="divide-y divide-stone-200">
					for _, review := range p.Reviews {
						<li class="py-6 first:pt-0">
							<article>
								<div class="flex items-center justify-between gap-4">
									@stars(review.Rating, strconv.Itoa(review.Rating), smallStars)
									<time datetime={ format.ISODate(review.Date.Time()) } class="text-sm text-stone-500">{ format.ShortDate(review.Date.Time()) }</time>
								</div>
								<h3 class="mt-3 font-semibold text-stone-900">{ review.Title }</h3>
								<p class="mt-2 leading-7 text-stone-600">{ review.Body }</p>
								<p class="mt-3 text-sm font-medium text-stone-900">{ review.Author }</p>
							</article>
						</li>
					}
				</ul>
			</section>
			<section aria-labelledby="related-heading" class="mt-16 border-t border-stone-200 pt-16">
				<h2 id="related-heading" class="text-xl font-semibold tracking-tight">You might also like</h2>
				<div class="mt-8 grid grid-cols-2 gap-x-6 gap-y-10 lg:grid-cols-4">
					for _, related := range p.RelatedProducts {
						@productCard(related)
					}
				</div>
			</section>
		</div>
	}
}

// purchase is the quantity stepper and add-to-cart button, or a disabled button when sold out.
templ purchase(p *catalog.Product) {
	if p.SoldOut() {
		<div class="mt-8">
			<button type="button" disabled class="w-full cursor-not-allowed rounded-full bg-stone-200 px-8 py-3.5 text-base font-semibold text-stone-500">
				Sold out
			</button>
		</div>
	} else {
		<div data-product-form data-max={ p.MaxQuantity() } class="mt-8">
			<div class="flex flex-col gap-3 sm:flex-row">
				<div class="flex items-center justify-between rounded-full border border-stone-300 bg-white p-1 sm:w-36">
					<button type="button" data-step="-1" aria-label="Decrease quantity" disabled class={ stepperButton }>
						@iconMinus()
					</button>
					<output data-quantity aria-live="polite" aria-label="Quantity" class="w-10 text-center font-semibold tabular-nums">1</output>
					<button type="button" data-step="1" aria-label="Increase quantity" disabled?={ p.MaxQuantity() <= 1 } class={ stepperButton }>
						@iconPlus()
					</button>
				</div>
				<button type="button" data-add-to-cart class="flex-1 rounded-full bg-teal-700 px-8 py-3.5 text-base font-semibold text-white shadow-sm hover:bg-teal-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700">
					Add to cart
				</button>
			</div>
			<p data-cart-status role="status" class="mt-3 min-h-5 text-sm font-medium text-teal-800"></p>
		</div>
	}
}
