package views

import "harbor-go-templ/assets"

// layout is the document shell shared by every HTML page.
//
// title is the page-specific part of the document title; "" gives just the store name.
templ layout(title string, cart int) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ documentTitle(title) }</title>
			<link rel="icon" href="data:,"/>
			<link rel="stylesheet" href={ assets.StylesheetPath }/>
			<script src={ assets.ScriptPath } defer></script>
		</head>
		<body class="flex min-h-screen flex-col bg-stone-50 text-stone-900 antialiased">
			<a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-white focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:shadow">
				Skip to content
			</a>
			@header(cart)
			<main id="main" class="flex-1">
				{ children... }
			</main>
			@footer()
		</body>
	</html>
}
